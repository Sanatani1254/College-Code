setwd("~/Downloads/Assignment1")
# 3(a) Load dataset and ggplot2
library(ggplot2)
df <- read.csv("Data.csv")
# Print first few rows in console
head(df)
# 3(b) Construct Plots
# 1. Bar Chart using geom_bar()
ggplot(df, aes(x = region, y = sales, fill = region)) +
geom_bar(stat = "identity") +
labs(title = "Sales by Region", x = "Region", y = "Sales") +
theme_minimal()
# 2. Scatter Plot using geom_point()
ggplot(df, aes(x = region, y = sales, color = region)) +
geom_point(size = 5) +
labs(title = "Sales vs. Region", x = "Region", y = "Sales") +
theme_minimal()
load("/home/suryansh/Downloads/Assignment1/.RData")
